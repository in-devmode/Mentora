rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // User sessions: owner user can read, create, update, delete only their own sessions
    match /sessions/{userId}/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // User profile: owner user can read and manage only their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Math solving history: owner user can read, create, update, delete their own math solutions
    match /users/{userId}/mathHistory/{historyId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
