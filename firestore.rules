rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny all documents
    match /{document=**} {
      allow read, write: if false;
    }

    // User sessions: a signed-in user can read and write only documents under their own uid; deny everything else
    match /sessions/{userId}/{sessionId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
